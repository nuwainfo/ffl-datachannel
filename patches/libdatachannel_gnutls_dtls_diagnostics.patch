+			if (char *sessionDescription = gnutls_session_get_desc(mSession)) {
+				PLOG_INFO << "DTLS handshake finished, session=" << sessionDescription;
+				gnutls_free(sessionDescription);
+			} else {
+				PLOG_INFO << "DTLS handshake finished";
+			}
 			changeState(State::Connected);
 			postHandshake();
 		}
@@ -233,6 +240,16 @@ void DtlsTransport::doRecv() {
 					return;
 				}
 
+				// Any other non-EAGAIN return is exceptional (retransmit, rehandshake
+				// rejection, remote close, or a fatal error handled below). Log its code
+				// and symbolic name for diagnosing connectivity issues; this branch is not
+				// on the per-packet success path, so it does not affect steady-state timing.
+				if (ret < 0) {
+					PLOG_DEBUG << "DTLS record recv: code=" << ret << " ("
+					           << gnutls_strerror_name(static_cast<int>(ret)) << ") "
+					           << gnutls_strerror(static_cast<int>(ret));
+				}
+
 				// RFC 8827: Implementations MUST NOT implement DTLS renegotiation and MUST reject
